# Public hostname for automatic HTTPS. For a local-only check, use http://localhost.
WANAFLOW_SITE_ADDRESS=process.example.com
BETTER_AUTH_URL=https://process.example.com
ACME_EMAIL=owner@example.com

POSTGRES_DB=wanaflow
POSTGRES_USER=wanaflow
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=
WANAFLOW_AI_MODEL=deepseek-v4-flash
WANAFLOW_AI_BASE_URL=https://api.deepseek.com/v1
COPILOTKIT_TELEMETRY_DISABLED=true
WANAFLOW_AUTH_SIGN_IN_RATE_LIMIT=5
WANAFLOW_IMAGE=wanaflow:local
WANAFLOW_HTTP_PORT=80
WANAFLOW_HTTPS_PORT=443

WANAFLOW_BOOTSTRAP_EMAIL=owner@example.com
WANAFLOW_BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
WANAFLOW_BOOTSTRAP_NAME=Organization owner
WANAFLOW_BOOTSTRAP_REVIEWER_EMAIL=reviewer@example.com
WANAFLOW_BOOTSTRAP_REVIEWER_PASSWORD=replace-with-a-second-long-unique-password
WANAFLOW_BOOTSTRAP_REVIEWER_NAME=Independent reviewer
WANAFLOW_BOOTSTRAP_ORGANIZATION_KEY=local
WANAFLOW_BOOTSTRAP_ORGANIZATION_NAME=Wanaflow
WANAFLOW_BOOTSTRAP_WORKSPACE_KEY=default
WANAFLOW_BOOTSTRAP_PROJECT_KEY=first-processes
